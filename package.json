{
  "name": "datarole-radar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit && vite build",
    "deploy": "npm run build && wrangler deploy",
    "dev": "vite dev",
    "preview": "npm run build && wrangler dev",
    "test": "vitest run",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply datarole-radar-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply datarole-radar-db --remote",
    "db:seed:local": "wrangler d1 execute datarole-radar-db --local --file=migrations/0002_seed.sql"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.2",
    "hono": "^4.10.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.0.6",
    "wrangler": "^4.45.0"
  }
}
